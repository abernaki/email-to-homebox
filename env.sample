# Email Configuration
# Works with any IMAP provider - see IMAP_PROVIDERS.md for full list
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993

# Common providers (uncomment and use the one you need):
# Gmail: imap.gmail.com:993 (app password required)
# Outlook: outlook.office365.com:993
# iCloud: imap.mail.me.com:993 (app password required)
# Fastmail: imap.fastmail.com:993
# Yahoo: imap.mail.yahoo.com:993 (app password required)

# Homebox Configuration
HOMEBOX_URL=https://your-homebox-url/
HOMEBOX_USERNAME=your-homebox-username
HOMEBOX_PASSWORD=your-homebox-password

# MLX Model Configuration
AI_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
AI_MAX_TOKENS=4096

# Processing Settings
CHECK_INTERVAL=300
MIN_CONFIDENCE=0.7

# Logging
LOG_LEVEL=INFO
